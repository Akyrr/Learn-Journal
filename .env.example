# Neon connection string (Neon console → Connection string → Pooled)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Password required to create/edit/delete entries (reading is public)
AUTH_PASSWORD="choose-a-strong-password"

# Random long string used to sign the login cookie (openssl rand -hex 32)
AUTH_SECRET="replace-with-64-hex-chars"
